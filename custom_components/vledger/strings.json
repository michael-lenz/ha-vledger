  "services": {
    "add_refuelling_receipt": {
      "name": "Add refuelling receipt",
      "description": "Enters a refuelling receipt for a vehicle, as `vledger receipt add refuelling` does, and answers with the line written, its UUID included.",
      "fields": {
        "config_entry_id": {
          "name": "Vehicle",
          "description": "The vehicle the receipt belongs to."
        },
        "anchor": {
          "name": "Time",
          "description": "When the refuelling or charge happened. Give this or the candidate's start, not both."
        },
        "from_candidate": {
          "name": "Candidate start",
          "description": "The start of a detected event: the receipt takes its time exactly."
        },
        "quantity_l": {
          "name": "Litres",
          "description": "The quantity on the receipt."
        },
        "full": {
          "name": "Full tank",
          "description": "Whether the tank was filled up."
        },
        "total_price": {
          "name": "Total price",
          "description": "The amount paid."
        },
        "unit_price": {
          "name": "Price per litre",
          "description": "The price per litre on the receipt."
        },
        "place": {
          "name": "Place",
          "description": "Where, as free text."
        },
        "fuel": {
          "name": "Fuel",
          "description": "The fuel type, as on the receipt."
        },
        "note": {
          "name": "Note",
          "description": "Anything else."
        },
        "replaces": {
          "name": "Replaces",
          "description": "The UUID of the receipt this one corrects; it is replaced whole."
        }
      }
    },
    "add_charging_receipt": {
      "name": "Add charging receipt",
      "description": "Enters a charging receipt for a vehicle, as `vledger receipt add charging` does, and answers with the line written, its UUID included.",
      "fields": {
        "config_entry_id": {
          "name": "Vehicle",
          "description": "The vehicle the receipt belongs to."
        },
        "anchor": {
          "name": "Time",
          "description": "When the refuelling or charge happened. Give this or the candidate's start, not both."
        },
        "from_candidate": {
          "name": "Candidate start",
          "description": "The start of a detected event: the receipt takes its time exactly."
        },
        "energy_kwh": {
          "name": "Energy",
          "description": "The billed energy in kWh."
        },
        "total_price": {
          "name": "Total price",
          "description": "The amount paid."
        },
        "place": {
          "name": "Place",
          "description": "Where, as free text."
        },
        "provider": {
          "name": "Provider",
          "description": "Who billed the charge, as free text."
        },
        "note": {
          "name": "Note",
          "description": "Anything else."
        },
        "replaces": {
          "name": "Replaces",
          "description": "The UUID of the receipt this one corrects; it is replaced whole."
        }
      }
    },
    "cancel_receipt": {
      "name": "Cancel receipt",
      "description": "Takes a receipt out with a cancellation of its own, as `vledger receipt cancel` does, and answers with the line written.",
      "fields": {
        "config_entry_id": {
          "name": "Vehicle",
          "description": "The vehicle the receipt belongs to."
        },
        "receipt": {
          "name": "Receipt",
          "description": "The UUID of the receipt to cancel."
        },
        "note": {
          "name": "Note",
          "description": "Anything else."
        }
      }
    },
    "recompute": {
      "name": "Recompute",
      "description": "Rebuilds the derivation on disk (L1) from the raw log, the receipts and the configuration, for one vehicle or charge point or for all of them. Capture goes on while it runs.",
      "fields": {
        "config_entry_id": {
          "name": "Vehicle or charge point",
          "description": "Which one to recompute; empty: all of them."
        }
      }
    }
  },
  "exceptions": {
    "refused": { "message": "Receipt refused: {reason}" },
    "not_a_vehicle": { "message": "{entry} is a charge point; receipts belong to a vehicle." },
    "entry_not_loaded": { "message": "No loaded vehicle or charge point has the entry {entry}." }
  }
